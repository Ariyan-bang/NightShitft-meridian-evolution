classDiagram
    direction TB

    class RunForecastCLI {
        <<Nightly CLI Entry>>
        +String db
        +String station
        +int year
        +bool parallel
        -- NO soil config CLI flag --
    }

    class Orchestrator {
        <<Pipeline Module>>
        +build_spec(store, stnid, year) ModelInputSpec
        +run_station_year(...)
        +run_all(...)
    }

    class DeckModule {
        <<Degenerate Hard-Coded Registry>>
        +Dict SOIL
        +Dict LATITUDE
        +Tuple DEFAULT_SOIL
        +float DEFAULT_LAT
        +soil_for(stnid) Tuple
        +latitude_for(stnid) float
        +spec_from_readings(...) ModelInputSpec
    }

    class SoilRegistry {
        <<Orphaned Modern Registry>>
        +Mapping stations
        +SoilParams defaults
        +from_yaml(path) SoilRegistry
        +from_ini(path) SoilRegistry
        +soil_for(stnid) SoilParams
    }

    class SoilParams {
        <<Value Object>>
        +float awc
        +float rooting_depth_mm
        +float latitude
        +validate(stnid)
    }

    class SoilSampleYAML {
        <<External Config File>>
        stations: GUELPH, KITCHNER...
        defaults: awc, rooting_depth
    }

    class SoilConfModule {
        <<Unwired Module>>
        +spec_from_readings_with(registry, ...)
    }

    RunForecastCLI ..> Orchestrator : runs nightly batch
    Orchestrator ..> DeckModule : invokes spec_from_readings()
    DeckModule ..> DeckModule : reads hard-coded SOIL dict
    SoilRegistry *-- SoilParams : contains
    SoilRegistry ..> SoilSampleYAML : parses
    SoilConfModule ..> SoilRegistry : uses
    Orchestrator -.-> SoilConfModule : MISSING LINK (Never called)
